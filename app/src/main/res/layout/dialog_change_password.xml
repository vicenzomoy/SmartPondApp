<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti Password"
        android:textColor="@color/sp_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Password Lama:"
        android:textColor="@color/sp_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etOldPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:hint="Masukkan password lama"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Password Baru:"
        android:textColor="@color/sp_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:hint="Minimal 6 karakter"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Konfirmasi Password Baru:"
        android:textColor="@color/sp_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:hint="Ulangi password baru"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

</LinearLayout>
