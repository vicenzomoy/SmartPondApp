<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah Jadwal Pakan"
        android:textColor="@color/sp_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Pilih Waktu (Jam:Menit):"
        android:textColor="@color/sp_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvSelectTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center"
        android:text="08:00"
        android:textColor="@color/sp_navy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Keterangan (misal: Pagi / Sore):"
        android:textColor="@color/sp_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etJadwalLabel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:hint="Contoh: Pagi"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Porsi (misal: Porsi 1x):"
        android:textColor="@color/sp_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etJadwalPortion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:hint="Contoh: Porsi 1x"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

</LinearLayout>
