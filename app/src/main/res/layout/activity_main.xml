<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    tools:context=".MainActivity">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_menu"
            android:src="@drawable/ic_menu_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnNotification"
            app:layout_constraintStart_toEndOf="@id/btnMenu"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_smart_pond"
                android:textColor="@color/sp_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline_smart_pond"
                android:textColor="@color/sp_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_notification"
            android:src="@drawable/ic_bell_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Main Dashboard Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Banner / Status Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardBanner"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pond_banner"
                android:elevation="2dp">

                <!-- Aquatic Plants Illustration (Left) -->
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="90dp"
                    android:contentDescription="@string/cd_aquatic_plant"
                    android:src="@drawable/ic_aquatic_plant"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Aquatic Plants Illustration (Right) -->
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="90dp"
                    android:contentDescription="@string/cd_aquatic_plant"
                    android:scaleX="-1"
                    android:src="@drawable/ic_aquatic_plant"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Fish Illustrations -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginStart="90dp"
                    android:contentDescription="@string/cd_fish_gray"
                    android:src="@drawable/ic_fish_gray"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:layout_width="65dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginEnd="90dp"
                    android:contentDescription="@string/cd_fish_orange"
                    android:src="@drawable/ic_fish_orange"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Top Status Overlay Header inside Banner -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutStatusHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_banner_top_overlay"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_status_dot"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivWifiIcon"
                        app:layout_constraintStart_toEndOf="@id/viewStatusDot"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvSystemStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_system_online"
                            android:textColor="@color/sp_navy"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSystemConnection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_connected"
                            android:textColor="@color/sp_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivWifiIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/cd_wifi"
                        android:src="@drawable/ic_wifi_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2x2 Grid of Dashboard Metric Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Row 1: Suhu Air & Kekeruhan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Card 1: Suhu Air -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardSuhu"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:elevation="1dp"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/ivSuhuIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/title_water_temp"
                            android:src="@drawable/ic_thermometer"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSuhuTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/title_water_temp"
                            android:textColor="@color/sp_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/ivSuhuIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivSuhuIcon"
                            app:layout_constraintTop_toTopOf="@id/ivSuhuIcon" />

                        <TextView
                            android:id="@+id/tvSuhuValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/default_suhu"
                            android:textColor="@color/sp_navy"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivSuhuIcon" />

                        <TextView
                            android:id="@+id/tvSuhuRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/default_suhu_range"
                            android:textColor="@color/sp_muted"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSuhuValue" />

                        <TextView
                            android:id="@+id/tvSuhuStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/status_normal"
                            android:textColor="@color/sp_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Card 2: Kekeruhan -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardKekeruhan"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:elevation="1dp"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/ivKekeruhanIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/title_turbidity"
                            android:src="@drawable/ic_waves"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKekeruhanTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/title_turbidity"
                            android:textColor="@color/sp_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/ivKekeruhanIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivKekeruhanIcon"
                            app:layout_constraintTop_toTopOf="@id/ivKekeruhanIcon" />

                        <TextView
                            android:id="@+id/tvKekeruhanValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/default_kekeruhan"
                            android:textColor="@color/sp_navy"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivKekeruhanIcon" />

                        <TextView
                            android:id="@+id/tvKekeruhanStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/default_kekeruhan_status"
                            android:textColor="@color/sp_muted"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvKekeruhanValue" />

                        <TextView
                            android:id="@+id/tvKekeruhanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/status_normal"
                            android:textColor="@color/sp_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

                <!-- Row 2: Level Air & Baterai -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Card 3: Level Air -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardLevelAir"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:elevation="1dp">

                        <ImageView
                            android:id="@+id/ivLevelAirIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="14dp"
                            android:contentDescription="@string/title_water_level"
                            android:src="@drawable/ic_droplet"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvLevelAirTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/title_water_level"
                            android:textColor="@color/sp_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/ivLevelAirIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivLevelAirIcon"
                            app:layout_constraintTop_toTopOf="@id/ivLevelAirIcon" />

                        <TextView
                            android:id="@+id/tvLevelAirValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/default_level_air"
                            android:textColor="@color/sp_navy"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivLevelAirIcon" />

                        <!-- Bottom Decorative Wave -->
                        <ImageView
                            android:id="@+id/ivLevelAirWave"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:scaleType="fitXY"
                            android:contentDescription="@string/cd_water_wave"
                            android:src="@drawable/bg_water_wave"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Card 4: Baterai -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardBaterai"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:elevation="1dp"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/ivBateraiIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/title_battery"
                            android:src="@drawable/ic_battery"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvBateraiTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/title_battery"
                            android:textColor="@color/sp_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/ivBateraiIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivBateraiIcon"
                            app:layout_constraintTop_toTopOf="@id/ivBateraiIcon" />

                        <TextView
                            android:id="@+id/tvBateraiVolt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/default_baterai_volt"
                            android:textColor="@color/sp_navy"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivBateraiIcon" />

                        <TextView
                            android:id="@+id/tvBateraiPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/default_baterai_percent"
                            android:textColor="@color/sp_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvBateraiVolt" />

                        <!-- Battery level progress bar -->
                        <ProgressBar
                            android:id="@+id/pbBaterai"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:max="100"
                            android:progress="78"
                            android:progressDrawable="@drawable/bg_battery_progress_fill"
                            android:background="@drawable/bg_battery_progress_track"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sp_card_bg"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemRippleColor="#1A073B67"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
