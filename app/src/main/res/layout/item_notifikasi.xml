<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotifContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_notif_red"
    android:padding="14dp">

    <!-- Circle Type Icon -->
    <ImageView
        android:id="@+id/ivNotifIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Notif Icon"
        android:src="@drawable/ic_notif_temp_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title & Message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvNotifTime"
        app:layout_constraintStart_toEndOf="@id/ivNotifIcon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sp_navy"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Suhu Air Terlalu Tinggi" />

        <TextView
            android:id="@+id/tvNotifMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/sp_muted"
            android:textSize="12sp"
            tools:text="Suhu mencapai 30.5 °C (di atas batas 30 °C)" />

    </LinearLayout>

    <!-- Time -->
    <TextView
        android:id="@+id/tvNotifTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E53935"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="14:20" />

</androidx.constraintlayout.widget.ConstraintLayout>
